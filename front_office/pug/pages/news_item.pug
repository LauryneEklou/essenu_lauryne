doctype html
html(lang="fr")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= article.title || 'Article'
    
    //- Basic styling for the page
    style.
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        line-height: 1.6;
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
        color: #333;
      }
      .article-featured {
        background: #fff;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      }
      .article-title {
        font-size: 2em;
        margin-bottom: 0.5em;
        color: #2c3e50;
      }
      .article-meta {
        color: #7f8c8d;
        margin-bottom: 1.5em;
        font-size: 0.9em;
      }
      .article-meta > * {
        margin-right: 15px;
      }
      .article-category {
        background: #3498db;
        color: white;
        padding: 3px 10px;
        border-radius: 3px;
        font-size: 0.85em;
      }
      .article-image img {
        width: 100%;
        height: auto;
        border-radius: 8px;
        margin-bottom: 1em;
      }
      .article-content {
        font-size: 1.1em;
        line-height: 1.8;
      }
      .article-content h1, .article-content h2, .article-content h3 {
        color: #2c3e50;
        margin-top: 1.5em;
        margin-bottom: 0.5em;
      }
      .article-content p {
        margin-bottom: 1em;
      }
      .article-content img {
        border-radius: 4px;
        margin: 1em 0;
      }
      .article-footer {
        margin-top: 2em;
        padding-top: 1em;
        border-top: 1px solid #eee;
      }
      .article-comments-count {
        color: #7f8c8d;
      }
      
      /* EditorJS enhanced content styling */
      .editorjs-output.editorjs-enhanced {
        /* Additional styling for enhanced content */
      }
  
  body
    //- Include the article mixin
    include ../mixins/article.pug
    
    //- Render the article using the mixin
    +article-featured(article)
    
    //- CRITICAL: Include the editorjs-renderer.js script
    //- This script targets .editorjs-output which is used in the +article-featured mixin
    script(src="/assets/js/editorjs-renderer.js")
    
    //- Optional: Add comments section or other interactive elements
    script.
      // Example: Log when renderer has processed the content
      document.addEventListener('DOMContentLoaded', function() {
        const enhanced = document.querySelector('.editorjs-output[data-enhanced="true"]');
        if (enhanced) {
          console.log('EditorJS content successfully enhanced!');
        } else {
          console.warn('EditorJS content was not enhanced - check if editorjs-renderer.js loaded correctly');
        }
      });
